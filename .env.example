# Copy to .env and adjust. Never commit .env.

# Application environment: development | test | production
APP_ENV=development

# Database connection (SQLAlchemy URL, psycopg 3 driver).
# Used when running the backend directly on your machine.
# Inside docker compose the backend overrides the host to "postgres".
DATABASE_URL=postgresql+psycopg://evalbench:evalbench@localhost:5432/evalbench

# --- LLM provider -------------------------------------------------------------
# mock              deterministic, offline (default)
# openai_compatible any OpenAI-compatible chat-completions API (Groq, NVIDIA NIM, ...)
LLM_PROVIDER=mock
# Leave empty for the provider default: "mock" / "openai/gpt-oss-20b".
LLM_MODEL=
# Groq:       https://api.groq.com/openai/v1
# NVIDIA NIM: https://integrate.api.nvidia.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
# Backend only; never exposed to the frontend.
LLM_API_KEY=
# json_schema = strict structured outputs (Groq gpt-oss models).
# json_object = JSON mode, for models without strict schema support (validated + retried).
LLM_STRUCTURED_MODE=json_schema
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
# Completion token budget per call. Keep this generous for reasoning models (gpt-oss):
# hidden reasoning tokens count toward it, and a truncated JSON output fails validation.
LLM_MAX_COMPLETION_TOKENS=8192
# Optional, only for providers that support it (Groq gpt-oss): low|medium|high.
# "low" cuts token burn and latency massively on free-tier Groq. Leave empty otherwise.
LLM_REASONING_EFFORT=
# Attempts per LLM call (timeouts, 5xx, malformed JSON) and for 429 rate limits.
LLM_MAX_ATTEMPTS=3
LLM_RATE_LIMIT_MAX_ATTEMPTS=6
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=30

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
